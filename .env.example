# Copy to .env.local and fill in from Supabase: Project Settings -> API.
# Leave both empty to run in demo mode (data saved in this browser only).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Set to "off" to skip sign-in and save entries in this browser only.
VITE_SIGN_IN=
# Google Calendar: an OAuth "Web application" client ID from Google Cloud (see README).
VITE_GOOGLE_CLIENT_ID=
